# -*- sh -*-
#
# registry-related tests
#

start_registry htpasswd

# Test unreachable
t POST /v1.40/auth username=$REGISTRY_USERNAME password=WrOnGPassWord serveraddress=doesnotexists.podman.io:1234/ \
  500 \
  .message~'.*no such host.*'

# Test with wrong password. Confirm bad status and appropriate error message
t POST /v1.40/auth username=$REGISTRY_USERNAME password=WrOnGPassWord serveraddress=localhost:$REGISTRY_PORT/ \
  500 \
  .message~'.* 401 Unauthorized'

# Test with the right password. Confirm status message
t POST /v1.40/auth username=$REGISTRY_USERNAME password=$REGISTRY_PASSWORD serveraddress=localhost:$REGISTRY_PORT/ \
  200 \
  .Status="Login Succeeded" \
  .IdentityToken=""

# Same test with url scheme provided
t POST /v1.40/auth username=$REGISTRY_USERNAME password=$REGISTRY_PASSWORD serveraddress=https://localhost:$REGISTRY_PORT/ \
  200 \
  .Status="Login Succeeded" \
  .IdentityToken=""

# Any scheme is accepted, localhost still skips TLS verification
t POST /v1.40/auth username=$REGISTRY_USERNAME password=$REGISTRY_PASSWORD serveraddress=http://localhost:$REGISTRY_PORT \
  200 \
  .Status="Login Succeeded"

# The registry uses a self-signed certificate: other hosts are verified...
t POST /v1.40/auth username=$REGISTRY_USERNAME password=$REGISTRY_PASSWORD serveraddress=127.0.0.1:$REGISTRY_PORT \
  500 \
  .message~'.*certificate.*'

# ...even when the URL looks like it starts with localhost
t POST /v1.40/auth username=$REGISTRY_USERNAME password=$REGISTRY_PASSWORD serveraddress=https://localhost:x@127.0.0.1:$REGISTRY_PORT/ \
  500 \
  .message~'.*certificate.*'

# ...unless registries.conf marks them insecure
orig_registries_conf_path=$registries_conf_path
registries_conf_path=$WORKDIR/registries-auth.conf
cat $orig_registries_conf_path - >$registries_conf_path <<EOF
[[registry]]
location="127.0.0.1:$REGISTRY_PORT"
insecure=true
EOF
stop_service
start_service

t POST /v1.40/auth username=$REGISTRY_USERNAME password=$REGISTRY_PASSWORD serveraddress=http://127.0.0.1:$REGISTRY_PORT \
  200 \
  .Status="Login Succeeded"

registries_conf_path=$orig_registries_conf_path
stop_service
start_service

# No username -> error
t POST /v1.40/auth password=$REGISTRY_PASSWORD serveraddress=localhost:$REGISTRY_PORT/ \
  500 \
  .message~'.* cannot prompt for username without stdin'


# No password -> error
t POST /v1.40/auth username=$REGISTRY_USERNAME serveraddress=https://localhost:$REGISTRY_PORT/ \
  500 \
  .message~'.* reading password: inappropriate ioctl for device'

stop_registry
